DATABASE_URL=postgresql://user:password@localhost:5432/dbname
PORT=3001
# Comma-separated origins (scheme + host, no trailing slash) allowed to call the
# API from a browser, e.g. https://linkbiomeds.com,https://www.linkbiomeds.com
CORS_ORIGIN=http://localhost:3000
ADMIN_API_KEY=

# Only needed to run `npm run upload-pdfs`. Created automatically in the Vercel
# dashboard when you attach a Blob store to the project; copy it here to upload
# from your machine.
BLOB_READ_WRITE_TOKEN=
